{
  "expo": {
    "name": "WI-BTK",
    "slug": "wi-btk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wibtk",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151826",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "WI-BTK — Suite modular de herramientas",
      "shortName": "WI-BTK",
      "description": "Suite modular de herramientas de escritorio para Windows y Linux. Instala solo los módulos que necesitas.",
      "themeColor": "#0c0e14",
      "backgroundColor": "#0c0e14"
    }
  }
}
